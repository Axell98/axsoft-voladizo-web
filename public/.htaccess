<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1. Forzar redirección permanente a HTTPS (301)
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 2. Manejo de rutas limpias para exportación estática de Next.js (SSG)
  # Permite que /proyectos, /contacto, etc. sirvan /proyectos.html sin mostrar la extensión
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.*)$ $1.html [L]
</IfModule>

# Cabeceras de seguridad recomendadas
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>
